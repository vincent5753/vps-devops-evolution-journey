# Copy this to terraform.tfvars and fill in your own values

# ---------- PVE ----------
pve_endpoint = "https://__your_pve_ip__:8006/"
# Generated by the last step of 00-pve-setup.sh
# Format: <user>@pve!<token-name>=<uuid>
pve_api_token = "OpenTofuUser@pve!provider=__your_token_uuid__"
pve_insecure  = true
pve_node      = "pve"

# ---------- VM ----------
vm_count       = 1
vm_name_prefix = "tofu-node"
vm_id_start    = 200
vm_cores       = 2
vm_memory      = 2048
vm_disk_size   = 20
