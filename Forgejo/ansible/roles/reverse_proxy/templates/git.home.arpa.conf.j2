# {{ ansible_managed }}

server {
    # IPv4 only, deliberately. This project disables IPv6 at the baseline, so
    # an [::] listener would bind a wildcard nothing can reach — decorative
    # residue that leaves the next reader unsure which state was intended.
    listen 80;
    server_name {{ forgejo_domain }};

    # No ACME here — the CA is self-signed (Stage 3 work line 1), so there is
    # no HTTP-01 challenge to serve. This exists purely to redirect.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ forgejo_domain }};

    ssl_certificate     {{ forgejo_tls_dir }}/{{ forgejo_domain }}.pem;
    ssl_certificate_key {{ forgejo_tls_dir }}/{{ forgejo_domain }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    # No ssl_stapling: Let's Encrypt shut down its OCSP responder in 2025 and
    # this CA is self-signed anyway — there is no responder to query.

    add_header Strict-Transport-Security "max-age=15552000" always;

    # Enforced as of 2026-08-18, after running it Report-Only first and
    # walking the full checklist in a real browser: file browsing, the
    # online editor, Markdown + Mermaid rendering, the issue/PR editor, and
    # every admin backend subpage — zero violations logged. Report-Only
    # first matters because a strict CSP can silently break the editor or
    # diagram rendering instead of failing loudly.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self';" always;

    client_max_body_size {{ forgejo_proxy_client_max_body_size }};

    location / {
        include /etc/nginx/snippets/forgejo-proxy-params.conf;
        proxy_pass http://127.0.0.1:{{ forgejo_http_port }};
    }

    location = /user/login {
        limit_req zone=forgejo_auth burst={{ forgejo_proxy_rate_limit_burst }} nodelay;
        include /etc/nginx/snippets/forgejo-proxy-params.conf;
        proxy_pass http://127.0.0.1:{{ forgejo_http_port }};
    }
}
