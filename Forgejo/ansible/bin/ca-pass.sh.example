#!/bin/sh
# cp to bin/ca-pass.sh, chmod 700. Consumed by 03-.../00-generate-ca.sh and
# 01-issue-leaf-cert.sh via `./bin/ca-pass.sh | openssl ... -pass stdin`.
# Print the passphrase to stdout and NOTHING else — a stray echo becomes
# part of the passphrase and openssl fails with a confusing "bad decrypt".
set -eu

# macOS Keychain. Store it once with:
#   security add-generic-password -a "$USER" -s forgejo-ca-passphrase -w
exec security find-generic-password -a "$USER" -s forgejo-ca-passphrase -w

# exec op read "op://Private/forgejo-ca-passphrase/password"
# exec pass show forgejo/ca-passphrase
# exec bw get password forgejo-ca-passphrase --raw
